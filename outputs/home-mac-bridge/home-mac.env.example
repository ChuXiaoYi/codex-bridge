# Set CODEX_REMOTE_BACKEND=http for the hosted Relay server mode.
# Set CODEX_REMOTE_BACKEND=github for the no-server GitHub Issues mode.
CODEX_REMOTE_BACKEND=http

# HTTP Relay mode.
# RELAY_URL=https://your-relay.example.com
# RELAY_BRIDGE_TOKEN=replace-with-a-long-random-token

# GitHub Issues mode.
# For more reliable GitHub Mobile alerts, use a bot/secondary GitHub account token here
# and set GITHUB_NOTIFY_USERNAME / GITHUB_NOTIFY_ASSIGNEES to your main account.
# The main account must be a collaborator on the private repo to receive private repo notifications.
# If the GitHub CLI is logged in on this Mac, GITHUB_TOKEN can be omitted.
# GITHUB_TOKEN=github_pat_replace_me
# GITHUB_TOKEN_COMMAND="gh auth token"
# GH_BIN=/opt/homebrew/bin/gh
# GITHUB_OWNER=your-github-user-or-org
# GITHUB_REPO=codex-remote
# GITHUB_TASK_LABEL=codex-remote
# GITHUB_DONE_LABEL=codex-done
# GITHUB_NOTIFY_USERNAME=your-github-username
# GITHUB_NOTIFY_ASSIGNEES=your-github-username
# GITHUB_POLL_MS=15000
# Keep this off unless you intentionally want task issue text to be public.
# GITHUB_ALLOW_PUBLIC_REPO=0

# Optional local bridge settings.
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8787
# BRIDGE_TOKEN=
# BRIDGE_CWD=/Users/chuxiaoyi/Documents/bridge
# CODEX_PATH=/Applications/Codex.app/Contents/Resources/codex
