# Set CODEX_REMOTE_BACKEND=http for the hosted Relay server mode.
# Set CODEX_REMOTE_BACKEND=github for the no-server GitHub Issues mode.
CODEX_REMOTE_BACKEND=http

# HTTP Relay mode.
# RELAY_URL=https://your-relay.example.com
# RELAY_BRIDGE_TOKEN=replace-with-a-long-random-token

# GitHub Issues mode.
# GITHUB_TOKEN=github_pat_replace_me
# GITHUB_OWNER=your-github-user-or-org
# GITHUB_REPO=codex-remote
# GITHUB_TASK_LABEL=codex-remote
# GITHUB_NOTIFY_USERNAME=your-github-username
# GITHUB_POLL_MS=15000

# Optional local bridge settings.
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8787
# BRIDGE_TOKEN=
# BRIDGE_CWD=/Users/chuxiaoyi/Documents/bridge
# CODEX_PATH=/Applications/Codex.app/Contents/Resources/codex
